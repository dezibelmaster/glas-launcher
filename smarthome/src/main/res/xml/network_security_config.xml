<?xml version="1.0" encoding="utf-8"?>
<!-- The FRITZ!Box answers on http://fritz.box inside the home network -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
