<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- WebRTC watches network changes -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- To open the Smart Life app for things only it may do, such as inviting family members -->
    <queries>
        <package android:name="com.tuya.smartlife" />
    </queries>

    <!-- Access data stays on the phone: no cloud backup of the Tuya secret -->
    <application
        android:label="Glas Smart"
        android:icon="@drawable/icon"
        android:roundIcon="@drawable/icon"
        android:allowBackup="false"
        android:theme="@style/Glas">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".DeviceActivity" android:exported="false" />
        <activity android:name=".FamilyActivity" android:exported="false" />
        <activity android:name=".WidgetConfigActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver android:name=".DeviceWidget" android:exported="true" android:label="@string/widget_device_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_device_info" />
        </receiver>
        <receiver android:name=".CameraWidget" android:exported="true" android:label="@string/widget_camera_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_camera_info" />
        </receiver>
        <activity android:name=".LiveActivity" android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />
        <!-- Opens setup links glassmart://setup?... from the family page of another phone -->
        <activity android:name=".SetupActivity" android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="glassmart" android:host="setup" />
            </intent-filter>
        </activity>
    </application>
</manifest>
